# Vorlage fuer eine lokale .env (nie committen). Ohne diese Werte zeigt die
# Seite Ankuendigungen "noch nicht mit der Datenbank verbunden".
# Nur den veroeffentlichbaren Schluessel eintragen, nie den geheimen (sb_secret_...).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_KEY=

# Optional: Zugangsabfrage wie in der Vorabphase (ADR-0010)
ZUGANGSWORT=
