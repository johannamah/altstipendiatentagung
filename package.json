  "private": true,
  "description": "Veranstaltungsapp fuer die Jahrestagung der Altstipendiaten der Konrad-Adenauer-Stiftung e. V.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
