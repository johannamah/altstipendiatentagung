---
import Basis from "../layouts/Basis.astro";
import Seitenkopf from "../components/Seitenkopf.astro";

/**
 * Ankuendigungen kommen zur Laufzeit aus Supabase (ADR-0014), nicht aus dem
 * Build: Eine Raumaenderung am Tagungsmorgen darf nicht auf ein Deployment
 * warten. Ohne Netz zeigt die Seite die zuletzt geladene Kopie.
 *
 * Die Eintraege entstehen im Browser. Scoped Styles erreichen sie deshalb nur
 * ueber :global() unterhalb von .ankuendigungen.
 */
---

<Basis
  titel="Ankündigungen – Jahrestagung 2027"
  beschreibung="Kurzfristige Neuigkeiten und Änderungen rund um die Jahrestagung 2027 in Hildesheim."
>
  <Seitenkopf
    ikone="megaphone"
    titel="Ankündigungen"
    einleitung="Hier informieren wir kurzfristig über Neuigkeiten und Änderungen rund um die Jahrestagung."
  />

  <div class="ankuendigungen" data-ankuendigungen aria-live="polite" aria-busy="true" tabindex="-1">
    <p class="karte">Ankündigungen werden geladen …</p>
  </div>

  <noscript>
    <p class="karte">Zum Anzeigen der Ankündigungen wird JavaScript benötigt.</p>
  </noscript>
</Basis>

<script>
  import {
    formatiereZeitpunkt,
    ladeAnkuendigungen,
    ladeKopie,
    speichereKopie,
    type Ankuendigung,
  } from "../lib/ankuendigungen.ts";

  const LEER =
    "Derzeit gibt es keine Ankündigungen. Sobald sich kurzfristig etwas ändert, steht es hier.";

  const bereich = document.querySelector<HTMLElement>("[data-ankuendigungen]");
  const url = import.meta.env.PUBLIC_SUPABASE_URL;
  const schluessel = import.meta.env.PUBLIC_SUPABASE_KEY;

  /* localStorage kann werfen (privates Fenster, gesperrte Website-Daten). */
  function speicher(): Storage | null {
    try {
      return localStorage;
    } catch {
      return null;
    }
  }

  /* Nur textContent, nie innerHTML: Die Texte kommen aus einer Datenbank. */
  function element<K extends keyof HTMLElementTagNameMap>(
    name: K,
    text?: string,
    klasse?: string,
  ): HTMLElementTagNameMap[K] {
    const knoten = document.createElement(name);
    if (text !== undefined) knoten.textContent = text;
    if (klasse) knoten.className = klasse;
    return knoten;
  }

  function liste(ankuendigungen: Ankuendigung[]): HTMLElement {
    if (ankuendigungen.length === 0) return element("p", LEER, "karte");

    const ol = element("ol", undefined, "liste");
    for (const eintrag of ankuendigungen) {
      const li = element("li", undefined, "karte");
      li.dataset.gewicht = eintrag.gewicht;

      const datum = element("p", undefined, "datum");
      const zeit = element("time", formatiereZeitpunkt(eintrag.veroeffentlichtAm));
      zeit.dateTime = eintrag.veroeffentlichtAm;
      datum.append(zeit);
      // Die Marke traegt die Information, der Balken ist nur die Zugabe (Regel 19).
      if (eintrag.gewicht === "wichtig") datum.append(element("span", "Wichtig", "marke"));

      li.append(datum, element("h2", eintrag.titel), element("p", eintrag.text, "text"));
      ol.append(li);
    }
    return ol;
  }

  function zeige(...knoten: HTMLElement[]) {
    bereich?.replaceChildren(...knoten);
    bereich?.setAttribute("aria-busy", "false");
  }

  async function laden(aufWunsch = false) {
    if (!bereich) return;

    if (!url || !schluessel) {
      zeige(
        element("p", "Die Ankündigungen sind noch nicht mit der Datenbank verbunden.", "karte"),
      );
      return;
    }

    bereich.setAttribute("aria-busy", "true");
    try {
      const ankuendigungen = await ladeAnkuendigungen({ url, schluessel });
      speichereKopie(speicher(), ankuendigungen, new Date());
      zeige(liste(ankuendigungen));
    } catch {
      const kopie = ladeKopie(speicher());
      if (kopie) {
        zeige(
          element(
            "p",
            `Keine Verbindung – angezeigt wird der Stand vom ${formatiereZeitpunkt(kopie.stand)}.`,
            "karte hinweis",
          ),
          liste(kopie.ankuendigungen),
        );
      } else {
        const karte = element("div", undefined, "karte");
        const knopf = element("button", "Erneut versuchen", "knopf");
        knopf.type = "button";
        knopf.addEventListener("click", () => laden(true));
        karte.append(
          element(
            "p",
            "Die Ankündigungen konnten gerade nicht geladen werden. Bitte prüfen Sie die Verbindung.",
          ),
          knopf,
        );
        zeige(karte);
      }
    }

    // Der Knopf ist nach dem Neuladen weg - der Fokus soll nicht ins Leere fallen.
    if (aufWunsch) bereich.focus();
  }

  void laden();
</script>

<style>
  .ankuendigungen :global(.liste) {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .ankuendigungen :global(.karte[data-gewicht="wichtig"]) {
    border-left: 4px solid var(--kachel-rot-von);
  }

  .ankuendigungen :global(.hinweis) {
    font-size: var(--schrift-klein);
    color: var(--hinweis-text);
    background: var(--hinweis-flaeche);
    border: 1px solid var(--hinweis-rand);
  }

  .ankuendigungen :global(.datum) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--raum-2);
    align-items: center;
    margin-bottom: var(--raum-1);
    font-size: var(--schrift-klein);
    color: var(--text-leise);
  }

  .ankuendigungen :global(.marke) {
    padding: 2px var(--raum-2);
    font-weight: 700;
    color: var(--kachel-rot-text);
    background: var(--kachel-rot-von);
    border-radius: 999px;
  }

  .ankuendigungen :global(h2) {
    font-size: var(--schrift-h3);
  }

  /* Zeilenumbrueche aus dem Table Editor bleiben erhalten. */
  .ankuendigungen :global(.text) {
    margin-bottom: 0;
    white-space: pre-line;
  }

  .ankuendigungen :global(.knopf) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: var(--raum-3) var(--raum-6);
    font: inherit;
    font-weight: 700;
    color: var(--kachel-blau-text);
    cursor: pointer;
    background: var(--kachel-blau-von);
    border: 0;
    border-radius: 999px;
  }
</style>
