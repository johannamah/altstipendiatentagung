---
import { getCollection } from "astro:content";

import Basis from "../layouts/Basis.astro";
import Programmpunkt from "../components/Programmpunkt.astro";
import Ikone from "../components/Ikone.astro";
import {
  formatiereDatum,
  formatiereTagKurz,
  nachTagenGruppieren,
  SPUR_TEXT,
  type Programmpunkt as Punkt,
  type Spur,
} from "../lib/programm.ts";

const orte = new Map(
  (await getCollection("orte")).map((eintrag) => [eintrag.id, { id: eintrag.id, ...eintrag.data }]),
);
/* Die Beschreibung der Exkursionen steht in exkursionen.json und wird hier
   ueber die gleiche Kennung dazugeholt. Sie doppelt zu pflegen waere genau
   das, wovor ADR-0006 warnt: Wer eine der beiden Stellen aendert, aendert die
   andere nicht - und niemand merkt es. */
const exkursionstexte = new Map(
  (await getCollection("exkursionen")).map((eintrag) => [eintrag.id, eintrag.data.info]),
);
const eintraege = await getCollection("programm");
const punkte: Punkt[] = eintraege.map((eintrag) => ({
  id: eintrag.id,
  ...eintrag.data,
  beschreibung: eintrag.data.beschreibung ?? exkursionstexte.get(eintrag.id),
}));
const { tage, ohneZeit } = nachTagenGruppieren(punkte);

/**
 * Fasst gleichzeitige Punkte derselben Spur zusammen. Die sieben Exkursionen am
 * Freitag sind Alternativen zueinander, keine Abfolge - eine schlichte Liste
 * wuerde das verschweigen.
 *
 * Das ist seit dem Entfernen der Zeitachse der einzige Weg, auf dem die
 * Gleichzeitigkeit sichtbar wird: Gruppenkopf mit Anzahl, eingerueckte
 * Eintraege, Verbindungslinie.
 */
type Gruppe = { schluessel: string; spur: Spur; punkte: Punkt[] };

function gruppiere(punkteDesTages: Punkt[]): Gruppe[] {
  const gruppen: Gruppe[] = [];

  for (const punkt of punkteDesTages) {
    const schluessel = `${punkt.spur}|${punkt.beginn ?? ""}|${punkt.ende ?? ""}`;
    const letzte = gruppen.at(-1);

    /* Gleiche Spur und gleiche Zeit heisst: Man muss sich entscheiden. Das gilt
       nicht nur fuer Exkursionen und Vortraege - am Donnerstag laufen
       Mitgliederversammlung und Partnerprogramm beide von 15:00 bis 17:00.
       Die Einschraenkung auf bestimmte Spuren hat genau das verschwiegen. */
    if (letzte?.schluessel === schluessel) {
      letzte.punkte.push(punkt);
    } else {
      gruppen.push({ schluessel, spur: punkt.spur, punkte: [punkt] });
    }
  }

  return gruppen;
}

const tageAufbereitet = tage.map((tag) => ({
  ...tag,
  gruppen: gruppiere(tag.punkte),
}));
---

<Basis
  titel="Programm – Jahrestagung 2027 | Altstipendiaten der Konrad-Adenauer-Stiftung"
  beschreibung="Das Programm der Altstipendiatentagung 2027 vom 5. bis 9. Mai in Hildesheim, Tag für Tag."
>
  <div class="kopf">
    <h1>
      <Ikone name="clipboard" /> Programm
    </h1>
    <p>
      Hier findet ihr alle Programmpunkte, Tag für Tag. Tippt auf einen Punkt für Beschreibung,
      Adresse und Wegbeschreibung. Der Stand ist noch nicht vollständig — einzelne Punkte sind als{" "}
      <strong>noch nicht bestätigt</strong> oder als <strong>Platzhalter</strong> gekennzeichnet.
    </p>
  </div>

  {/* Braucht JavaScript und wird erst davon eingeblendet. */}
  <div class="werkzeuge" id="werkzeuge" hidden>
    <button class="werkzeug" type="button" id="nurMeine" aria-pressed="false">
      <Ikone name="check" />
      <span id="nurMeineText">Nur mein Programm</span>
    </button>

    <button class="werkzeug" type="button" id="alleExportieren" disabled>
      <Ikone name="calendar" />
      <span>Mein Programm in den Kalender</span>
    </button>

    <p class="werkzeug-hinweis">Eure Auswahl liegt nur auf diesem Gerät und in diesem Browser.</p>
  </div>

  {/* Meldungen fuer Screenreader und Bildschirm zugleich (Regel 43). */}
  <p class="meldung" id="meldung" role="status" aria-live="polite"></p>

  <nav class="tagesauswahl" aria-label="Tage der Tagung">
    <ul>
      {tageAufbereitet.map((tag) => (
        <li>
          <a href={`#tag-${tag.datum}`}>{formatiereTagKurz(tag.datum)}</a>
        </li>
      ))}
    </ul>
  </nav>

  {tageAufbereitet.map((tag) => (
    <section class="tag" id={`tag-${tag.datum}`} aria-labelledby={`ueberschrift-${tag.datum}`}>
      <h2 id={`ueberschrift-${tag.datum}`}>{formatiereDatum(tag.datum)}</h2>

      <ol class="tagesliste">
        {tag.gruppen.map((gruppe, nummer) => {
          /* Gleichzeitige Punkte gehoeren zusammen und schliessen einander
               aus. Zusammengehalten werden sie ueber data-gruppe: Einrueckung
               und Verbindungslinie im CSS, Auf- und Zuklappen im Skript.

               Die Liste bleibt dabei flach. Mit der Zeitachse war das
               zwingend, weil sie jeden Eintrag einzeln im Raster platzierte;
               jetzt waere eine verschachtelte Liste moeglich und semantisch
               genauer. Das ist ein eigener Umbau und keine Nebenwirkung
               dieser Entfernung. */
          const gruppenKennung = gruppe.punkte.length > 1 ? `${tag.datum}-${nummer}` : undefined;

          return (
            <>
              {gruppenKennung && (
                <li class="gruppenkopf" data-gruppenkopf={gruppenKennung}>
                  <span>
                    <b>
                      {SPUR_TEXT[gruppe.spur] ?? "Gleichzeitig"} · {gruppe.punkte.length} zur Wahl
                    </b>
                    <br />
                    Diese Punkte laufen parallel – ihr entscheidet euch für einen.
                  </span>

                  {/* Braucht JavaScript und wird erst davon eingeblendet. */}
                  <button
                    class="gruppe-umschalter"
                    type="button"
                    aria-expanded="true"
                    data-gruppe={gruppenKennung}
                    hidden
                  >
                    <span data-umschalter-text>Einklappen</span>
                    <span class="nur-vorlesen">: {gruppe.punkte.length} gleichzeitige Punkte</span>
                  </button>
                </li>
              )}
              {gruppe.punkte.map((punkt) => (
                <li class="eintrag" data-gruppe={gruppenKennung}>
                  <Programmpunkt
                    punkt={punkt}
                    ort={punkt.ortId ? orte.get(punkt.ortId) : undefined}
                  />
                </li>
              ))}
            </>
          );
        })}
      </ol>
    </section>
  ))}

  {ohneZeit.length > 0 && (
    <section class="tag" aria-labelledby="ueberschrift-ohne-zeit">
      <h2 id="ueberschrift-ohne-zeit">Noch ohne Termin</h2>
      <p class="einleitung">Diese Punkte sind geplant, stehen aber noch nicht fest im Ablauf.</p>
      {ohneZeit.map((punkt) => (
        <Programmpunkt punkt={punkt} ort={punkt.ortId ? orte.get(punkt.ortId) : undefined} />
      ))}
    </section>
  )}
  {/* Die Daten, die das Skript braucht - als JSON statt in jedem Element
      verteilt, damit die Seite nicht mit Attributen zugestellt wird. */}
  <script
    type="application/json"
    id="programmdaten"
    set:html={JSON.stringify({ punkte, orte: [...orte.values()] })}
  />
</Basis>

<script>
  import { alsKalender, dateiname, istExportierbar } from "../lib/kalender.ts";
  import type { Programmpunkt } from "../lib/programm.ts";
  import type { Ort } from "../lib/orte.ts";
  import { browserSpeicher, ladeAuswahl, speichereAuswahl, umschalten } from "../lib/merkliste.ts";
  import { jetztAlsOrtszeit, laufendUm } from "../lib/zeit.ts";

  const datenElement = document.getElementById("programmdaten");
  const daten: { punkte: Programmpunkt[]; orte: Ort[] } = datenElement
    ? JSON.parse(datenElement.textContent ?? '{"punkte":[],"orte":[]}')
    : { punkte: [], orte: [] };
  const punkte = daten.punkte;
  const nachId = new Map(punkte.map((punkt) => [punkt.id, punkt]));
  const orteNachId = new Map(daten.orte.map((ort) => [ort.id, ort]));

  const meldung = document.getElementById("meldung");
  const werkzeuge = document.getElementById("werkzeuge");
  const nurMeine = document.getElementById("nurMeine");
  const nurMeineText = document.getElementById("nurMeineText");
  const alleExportieren = document.getElementById("alleExportieren") as HTMLButtonElement | null;

  const speicher = browserSpeicher();
  let auswahl = ladeAuswahl(speicher, [...nachId.keys()]);
  let nurAuswahlZeigen = false;

  function melde(text: string): void {
    if (meldung) meldung.textContent = text;
  }

  /* ===== "Jetzt laeuft" ===== */

  function markiereZeitlage(): void {
    const jetzt = jetztAlsOrtszeit();
    const { laufend, naechster } = laufendUm(punkte, jetzt);
    const laufendeIds = new Set(laufend.map((punkt) => punkt.id));

    for (const element of document.querySelectorAll<HTMLElement>(".punkt")) {
      const id = element.dataset.id;
      const marke = element.querySelector<HTMLElement>(".lage");
      if (!id || !marke) continue;

      if (laufendeIds.has(id)) {
        element.dataset.lage = "jetzt";
        marke.textContent = "Jetzt";
        marke.hidden = false;
      } else if (naechster?.id === id && laufend.length === 0) {
        element.dataset.lage = "danach";
        marke.textContent = "Als Nächstes";
        marke.hidden = false;
      } else {
        delete element.dataset.lage;
        marke.hidden = true;
      }
    }

    const ziel = laufend[0] ?? (laufend.length === 0 ? naechster : null);
    if (!ziel) return;

    const zielElement = document.querySelector<HTMLElement>(`.punkt[data-id="${ziel.id}"]`);

    /* Was gerade laeuft, wird aufgeklappt: Wer waehrend der Tagung die Seite
       oeffnet, will die Einzelheiten sehen und nicht erst tippen muessen. */
    if (zielElement instanceof HTMLDetailsElement) zielElement.open = true;
    zielElement?.scrollIntoView({
      // Wer Bewegung reduziert haben will, springt (Regel 37).
      behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
      block: "center",
    });
  }

  /* ===== Download ===== */

  function ladeHerunter(ausgewaehlte: Programmpunkt[]): void {
    const datei = new Blob([alsKalender(ausgewaehlte, orteNachId)], {
      type: "text/calendar;charset=utf-8",
    });
    const adresse = URL.createObjectURL(datei);
    const verweis = document.createElement("a");

    verweis.href = adresse;
    verweis.download = dateiname(ausgewaehlte);
    verweis.click();

    URL.revokeObjectURL(adresse);
  }

  /* ===== Auswahl ===== */

  function zeichneAuswahl(): void {
    for (const element of document.querySelectorAll<HTMLElement>(".punkt")) {
      const id = element.dataset.id;
      const knopf = element.querySelector<HTMLButtonElement>("[data-merken]");
      const text = element.querySelector<HTMLElement>("[data-merken-text]");
      if (!id || !knopf || !text) continue;

      const gemerkt = auswahl.includes(id);
      knopf.setAttribute("aria-pressed", String(gemerkt));
      text.textContent = gemerkt ? "Gemerkt" : "Merken";

      // Beim Filtern bleiben Punkte ohne Auswahl verborgen.
      element.closest("li")?.toggleAttribute("hidden", nurAuswahlZeigen && !gemerkt);
      if (!element.closest("li")) element.toggleAttribute("hidden", nurAuswahlZeigen && !gemerkt);
    }

    // Leer gewordene Abschnitte ausblenden, damit keine Ueberschrift ohne
    // Inhalt stehen bleibt.
    for (const abschnitt of document.querySelectorAll<HTMLElement>(".tag")) {
      const sichtbar = [...abschnitt.querySelectorAll<HTMLElement>(".punkt")].some(
        (punkt) => !punkt.hasAttribute("hidden") && !punkt.closest("li[hidden]"),
      );
      abschnitt.toggleAttribute("hidden", nurAuswahlZeigen && !sichtbar);
    }

    if (alleExportieren) {
      alleExportieren.disabled =
        auswahl.filter((id) => istExportierbar(nachId.get(id)!)).length === 0;
    }
  }

  /* ===== Verdrahtung ===== */

  for (const element of document.querySelectorAll<HTMLElement>(".punkt")) {
    const id = element.dataset.id;
    if (!id) continue;

    element.querySelector<HTMLElement>(".aktionen")?.removeAttribute("hidden");

    element.querySelector<HTMLButtonElement>("[data-merken]")?.addEventListener("click", () => {
      auswahl = umschalten(auswahl, id);
      const gespeichert = speichereAuswahl(speicher, auswahl);
      zeichneAuswahl();

      const titel = nachId.get(id)?.titel ?? "Programmpunkt";
      if (!gespeichert) {
        melde(`„${titel}“ gemerkt — lässt sich in diesem Browser aber nicht dauerhaft sichern.`);
      } else {
        melde(
          auswahl.includes(id)
            ? `„${titel}“ zu eurem Programm hinzugefügt.`
            : `„${titel}“ aus eurem Programm entfernt.`,
        );
      }
    });

    element.querySelector<HTMLButtonElement>("[data-kalender]")?.addEventListener("click", () => {
      const punkt = nachId.get(id);
      if (punkt) ladeHerunter([punkt]);
    });
  }

  werkzeuge?.removeAttribute("hidden");

  /* ===== Gruppen auf- und zuklappen =====
     Ohne JavaScript bleibt alles sichtbar - der Umschalter erscheint erst
     hier. Zugeklappt wird nur die Darstellung; die Punkte bleiben im Dokument
     und damit fuer "Mein Programm" und die Jetzt-Markierung erreichbar. */
  for (const knopf of document.querySelectorAll<HTMLButtonElement>(".gruppe-umschalter")) {
    const kennung = knopf.dataset.gruppe;
    if (!kennung) continue;

    knopf.removeAttribute("hidden");

    knopf.addEventListener("click", () => {
      const offen = knopf.getAttribute("aria-expanded") !== "false";
      const text = knopf.querySelector("[data-umschalter-text]");

      for (const eintrag of document.querySelectorAll<HTMLElement>(
        `.eintrag[data-gruppe="${kennung}"]`,
      )) {
        eintrag.toggleAttribute("hidden", offen);
      }

      knopf.setAttribute("aria-expanded", String(!offen));
      if (text) text.textContent = offen ? "Ausklappen" : "Einklappen";
    });
  }

  nurMeine?.addEventListener("click", () => {
    nurAuswahlZeigen = !nurAuswahlZeigen;
    nurMeine.setAttribute("aria-pressed", String(nurAuswahlZeigen));
    if (nurMeineText) {
      nurMeineText.textContent = nurAuswahlZeigen ? "Ganzes Programm" : "Nur mein Programm";
    }
    zeichneAuswahl();

    if (nurAuswahlZeigen && auswahl.length === 0) {
      melde("Ihr habt euch noch nichts gemerkt. Tippt bei einem Punkt auf „Merken“.");
    } else {
      melde(nurAuswahlZeigen ? `Es werden ${auswahl.length} gemerkte Punkte gezeigt.` : "");
    }
  });

  alleExportieren?.addEventListener("click", () => {
    const ausgewaehlte = auswahl
      .map((id) => nachId.get(id))
      .filter((punkt): punkt is Programmpunkt => punkt !== undefined && istExportierbar(punkt));

    if (ausgewaehlte.length > 0) ladeHerunter(ausgewaehlte);
  });

  zeichneAuswahl();
  markiereZeitlage();
</script>

<style>
  .kopf {
    margin-bottom: var(--raum-6);
  }

  .kopf h1 {
    display: flex;
    gap: var(--raum-2);
    align-items: center;
  }

  .kopf p,
  .einleitung {
    color: var(--text-leise);
  }

  /* Sticky, damit der Tageswechsel beim Durchscrollen erreichbar bleibt.
     Der Versatz entspricht der Hoehe der Kopfleiste. */
  .tagesauswahl {
    position: sticky;
    top: 66px;
    z-index: 10;
    padding: var(--raum-2) 0;
    margin-bottom: var(--raum-6);
    background: var(--flaeche);
  }

  .tagesauswahl ul {
    display: flex;
    gap: var(--raum-2);
    padding: 0;
    margin: 0;
    overflow-x: auto;
    list-style: none;
  }

  .tagesauswahl a {
    display: block;
    /* Mindestgroesse fuer Beruehrung (Regel 7). */
    min-height: 44px;
    padding: var(--raum-2) var(--raum-4);
    font-size: var(--schrift-klein);
    font-weight: 600;
    color: var(--text-leise);
    white-space: nowrap;
    text-decoration: none;
    background: var(--karte);
    border: 1px solid var(--rand);
    border-radius: 999px;
  }

  .tagesauswahl a:hover {
    background: var(--hover);
  }

  .tag {
    margin-bottom: var(--raum-12);
    /* Sprungmarke nicht unter der Kopfleiste verstecken. */
    scroll-margin-top: 120px;
  }

  .tag h2 {
    padding-bottom: var(--raum-2);
    border-bottom: 2px solid var(--rand);
  }

  /* ===== Tagesansicht ===== */

  .tagesliste {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .eintrag {
    margin-bottom: var(--raum-3);
  }

  /* Der Gruppenkopf sagt in Worten, was die Einrueckung zeigt: Diese Punkte
     schliessen einander aus. Beides zusammen, weil Einrueckung allein eine
     Gestaltungsentscheidung sein koennte und damit missverstaendlich ist. */
  .gruppenkopf {
    display: flex;
    flex-wrap: wrap;
    gap: var(--raum-2);
    align-items: center;
    justify-content: space-between;
    padding: var(--raum-3);
    margin-bottom: var(--raum-2);
    font-size: var(--schrift-klein);
    color: var(--text-leise);
    background: var(--hover);
    border: 1px dashed var(--rand);
    border-radius: var(--radius-klein);
  }

  .gruppe-umschalter {
    flex: none;
    min-height: 44px;
    padding: var(--raum-2) var(--raum-3);
    font: inherit;
    font-size: var(--schrift-klein);
    font-weight: 600;
    color: var(--akzent);
    cursor: pointer;
    background: var(--feld);
    border: 1px solid var(--feldrand);
    border-radius: 999px;
  }

  .gruppe-umschalter:hover {
    background: var(--hover);
  }

  /* Eingerueckt und mit Verbindungslinie: Die Punkte gehoeren zum Kopf
     darueber und stehen nicht gleichrangig im Tagesablauf. */
  .eintrag[data-gruppe] {
    position: relative;
    padding-left: var(--raum-4);
    margin-left: var(--raum-3);
    border-left: 2px solid var(--rand);
  }

  .eintrag[data-gruppe]:last-of-type {
    margin-bottom: var(--raum-6);
  }

  .werkzeuge {
    display: flex;
    flex-wrap: wrap;
    gap: var(--raum-2);
    align-items: center;
    padding: var(--raum-3);
    margin-bottom: var(--raum-4);
    background: var(--karte);
    border: 1px solid var(--rand);
    border-radius: var(--radius);
  }

  .werkzeug {
    display: inline-flex;
    gap: var(--raum-2);
    align-items: center;
    min-height: 44px;
    padding: var(--raum-2) var(--raum-4);
    font: inherit;
    font-size: var(--schrift-klein);
    font-weight: 600;
    color: var(--akzent);
    cursor: pointer;
    background: var(--feld);
    border: 1px solid var(--feldrand);
    border-radius: 999px;
  }

  .werkzeug:hover:not(:disabled) {
    background: var(--hover);
  }

  .werkzeug:disabled {
    color: var(--text-leise);
    cursor: not-allowed;
    opacity: 0.6;
  }

  .werkzeug[aria-pressed="true"] {
    color: var(--kachel-gruen-text);
    background: var(--kachel-gruen-von);
    border-color: var(--kachel-gruen-von);
  }

  /* Der Hinweis gehoert sichtbar daneben, nicht in eine Fussnote: Sonst
     rechnen Nutzende damit, ihre Auswahl auf dem Laptop wiederzufinden. */
  .werkzeug-hinweis {
    flex-basis: 100%;
    margin: 0;
    font-size: var(--schrift-klein);
    color: var(--text-leise);
  }

  .meldung:not(:empty) {
    padding: var(--raum-2) var(--raum-3);
    margin-bottom: var(--raum-4);
    font-size: var(--schrift-klein);
    color: var(--hinweis-text);
    background: var(--hinweis-flaeche);
    border-radius: var(--radius-klein);
  }
</style>
