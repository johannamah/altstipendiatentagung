---
import { getCollection } from "astro:content";

import Basis from "../layouts/Basis.astro";
import Seitenkopf from "../components/Seitenkopf.astro";

const eintraege = await getCollection("faq");
---

<Basis
  titel="Häufige Fragen – Jahrestagung 2027"
  beschreibung="Antworten auf häufige Fragen zur Altstipendiatentagung 2027 in Hildesheim."
>
  <Seitenkopf
    ikone="help"
    titel="Häufig gestellte Fragen"
    einleitung="Tippt auf eine Frage, um die Antwort zu sehen."
  />

  {/* <details> statt eigenem Aufklapp-Skript: funktioniert ohne JavaScript,
      ist von Haus aus mit der Tastatur bedienbar und wird von Screenreadern
      korrekt als auf- und zuklappbar angekündigt (Regel 42). */}
  <div class="fragen">
    {eintraege.map((eintrag) => (
      <details class="karte" name="faq">
        <summary>{eintrag.data.frage}</summary>
        <div class="antwort">
          <p>{eintrag.data.antwort}</p>

          {/* <ol> und nicht <p> mit Nummern im Text: Screenreader kuendigen die
              Anzahl der Schritte an, und die Reihenfolge ist dann Semantik und
              nicht bloss Schreibweise (Regel 42). */}
          {eintrag.data.schritte && (
            <ol class="schritte">
              {eintrag.data.schritte.map((schritt) => (
                <li>{schritt}</li>
              ))}
            </ol>
          )}

          {eintrag.data.hinweis && <p class="hinweis">{eintrag.data.hinweis}</p>}
        </div>
      </details>
    ))}
  </div>
</Basis>

<style>
  details {
    padding: 0;
  }

  summary {
    /* Mindestgroesse fuer Beruehrung (Regel 7). */
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: var(--raum-3) var(--raum-4);
    font-weight: 600;
    cursor: pointer;
  }

  summary:hover {
    background: var(--hover);
  }

  details[open] summary {
    border-bottom: 1px solid var(--rand);
  }

  .antwort {
    padding: var(--raum-4);
  }

  .antwort p {
    margin: 0;
    color: var(--text-leise);
  }

  .schritte {
    display: grid;
    gap: var(--raum-3);
    /* Platz fuer die Ziffern, damit der Text nicht am Rand des Kaertchens
       klebt und bei zweistelligen Schritten nicht springt. */
    padding-left: var(--raum-6);
    margin: var(--raum-4) 0 0;
    color: var(--text);
  }

  .schritte li {
    padding-left: var(--raum-1);
  }

  .schritte li::marker {
    font-weight: 700;
    color: var(--akzent);
  }

  .hinweis {
    margin-top: var(--raum-4);
    font-size: var(--schrift-klein);
  }
</style>
