---
import { getCollection, render } from "astro:content";

import Basis from "../layouts/Basis.astro";
import Seitenkopf from "../components/Seitenkopf.astro";
import Platzhalterhinweis from "../components/Platzhalterhinweis.astro";
import Ikone from "../components/Ikone.astro";
import Ortsangabe from "../components/Ortsangabe.astro";
import type { Ort } from "../lib/orte.ts";

const abschnitte = (await getCollection("stadt")).sort(
  (a, b) => a.data.reihenfolge - b.data.reihenfolge,
);

/* Die Abschnitte werden vorab gerendert: Astro erlaubt kein await innerhalb
   des Markups, und ein Aufruf je Abschnitt im Template waere ohnehin
   schwerer zu lesen. */
const gerendert = await Promise.all(
  abschnitte.map(async (abschnitt) => ({
    ...abschnitt.data,
    Inhalt: (await render(abschnitt)).Content,
  })),
);

const zahlen = (await getCollection("stadtzahlen")).map((eintrag) => eintrag.data);

const gastronomie: Ort[] = (await getCollection("orte"))
  .map((eintrag) => ({ id: eintrag.id, ...eintrag.data }))
  .filter((ort) => ort.art === "gastronomie");
const links = (await getCollection("stadtlinks")).map((eintrag) => eintrag.data);

const sehenswuerdigkeiten = [
  "Dom St. Mariae & Domschatz (UNESCO-Welterbe)",
  "St. Michaeliskirche (UNESCO-Welterbe)",
  "Marktplatz mit Knochenhauer-Amtshaus",
  "St. Godehard-Basilika",
  "Roemer- und Pelizaeus-Museum",
  "Historische Altstadt und Wallanlagen",
];
---

<Basis
  titel="Hildesheim – Jahrestagung 2027"
  beschreibung="Geschichte, UNESCO-Welterbe und Tipps für die Zeit neben dem Programm der Jahrestagung 2027 in Hildesheim."
>
  <Seitenkopf
    ikone="landmark"
    titel="Hildesheim"
    einleitung="Eine Stadt mit mehr als 1.200 Jahren Geschichte – und ein paar Tipps für die Zeit neben dem Programm."
  />

  {gerendert.map(({ titel, ikone, Inhalt }) => (
    <article class="karte fliesstext">
      <h2>
        <Ikone name={ikone} />
        <span>{titel}</span>
      </h2>
      <Inhalt />
    </article>
  ))}

  <section class="karte">
    <h2>
      <Ikone name="clipboard" /> Hildesheim in Zahlen
    </h2>
    {/* <dl>, weil es Paare aus Wert und Erläuterung sind - Screenreader
        kündigen die Zusammengehörigkeit dann von selbst an. */}
    <dl class="zahlen">
      {zahlen.map((zahl) => (
        <div>
          <dt>{zahl.wert}</dt>
          <dd>{zahl.was}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="karte">
    <h2>
      <Ikone name="eye" /> Sehenswürdigkeiten
    </h2>
    <ul>
      {sehenswuerdigkeiten.map((eintrag) => (
        <li>{eintrag}</li>
      ))}
    </ul>
  </section>

  <section class="karte">
    <h2>
      <Ikone name="utensils" /> Essen & Trinken
    </h2>
    <p>
      Rund um den Marktplatz und die Almstraße liegen zahlreiche Restaurants und Cafés. Diese
      Auswahl stammt aus einer ersten Recherche – tippt auf Google Maps oder Apple Karten, um euch
      hinführen zu lassen.
    </p>

    <ul class="lokale">
      {gastronomie.map((lokal) => (
        <li>
          {lokal.hinweis && <p class="kueche">{lokal.hinweis}</p>}
          <Ortsangabe ort={lokal} />
        </li>
      ))}
    </ul>
  </section>

  <Platzhalterhinweis>
    Diese Liste stammt aus öffentlichen Bewertungsportalen (Stand: Recherche 2026) und ist noch
    nicht vom Orga-Team geprüft. Die Straßenadressen fehlen – die Verweise suchen deshalb nach dem
    Namen. Eine kuratierte Auswahl mit vollständigen Adressen wird nachgereicht.
  </Platzhalterhinweis>

  <section class="karte">
    <h2>
      <Ikone name="globe" /> Weiterführende Informationen
    </h2>
    <ul class="links">
      {links.map((eintrag) => (
        <li>
          <a href={eintrag.web} target="_blank" rel="noopener">
            {eintrag.titel}
          </a>
        </li>
      ))}
    </ul>
  </section>
</Basis>

<style>
  h2 {
    margin-bottom: var(--raum-3);
    font-size: var(--schrift-h3);
  }

  /* Die Abschnitte kommen aus Markdown - die Regeln greifen deshalb auf die
     erzeugten Elemente, nicht auf eigene Klassen. */
  .fliesstext :global(p) {
    margin-bottom: var(--raum-4);
  }

  .fliesstext :global(p:last-child) {
    margin-bottom: 0;
  }

  .fliesstext :global(a) {
    color: var(--akzent);
  }

  .zahlen {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: var(--raum-4);
    margin: 0;
  }

  .zahlen dt {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--akzent);
  }

  .zahlen dd {
    margin: var(--raum-1) 0 0;
    font-size: var(--schrift-klein);
    color: var(--text-leise);
  }

  .links {
    padding-left: var(--raum-6);
  }

  .lokale {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: var(--raum-4);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .lokale li {
    padding: var(--raum-3);
    background: var(--flaeche);
    border-radius: var(--radius-klein);
  }

  .kueche {
    margin: 0 0 var(--raum-2);
    font-size: var(--schrift-klein);
    font-weight: 600;
    color: var(--akzent);
  }
</style>
