---
import Basis from "../layouts/Basis.astro";
import Seitenkopf from "../components/Seitenkopf.astro";
import Ikone from "../components/Ikone.astro";
import { FOTOALBUM_URL } from "../daten/fotos.ts";

/**
 * Fotoalbum im OneDrive des Vereins (Entscheidung vom 27.09.2026 fuer
 * Microsoft 365, ADR-0009; seit 28.11.2026 OneDrive). Der Zugang ist mit einem
 * Passwort geschuetzt, das auf der Tagung bekannt gegeben wird.
 *
 * Die App verlinkt nur - sie nimmt selbst keine Bilder entgegen. Das haelt die
 * offene Rechtsfrage F5 (Einwilligung, Widerruf, Loeschung bei Personenbildern)
 * ausserhalb der Anwendung: Wir speichern keine Fotos und muessen keine
 * loeschen.
 *
 * Die Adresse steht in src/daten/fotos.ts. Bis sie feststeht, steht KEIN
 * Knopf da, der ins Leere fuehrt.
 */
---

<Basis
  titel="Fotos – Jahrestagung 2027"
  beschreibung="Gemeinsames Fotoalbum der Altstipendiatentagung 2027 in Hildesheim."
>
  <Seitenkopf
    ikone="camera"
    titel="Fotos"
    einleitung="Teilt eure schönsten Momente der Tagung und schaut euch die Fotos der anderen Teilnehmenden an."
  />

  <section class="karte">
    <h2>
      <Ikone name="camera" /> Gemeinsames Fotoalbum
    </h2>

    <p>
      Die Fotos der Tagung liegen im OneDrive des Vereins. Dort gibt es auch einen Bereich, in dem
      ihr selbst Fotos teilen könnt. Der Zugang ist durch ein Passwort geschützt, das auf der Tagung
      bekannt gegeben wird.
    </p>

    {FOTOALBUM_URL ? (
      <a class="knopf" href={FOTOALBUM_URL} target="_blank" rel="noopener">
        <Ikone name="upload" />
        <span>Fotos ansehen & hochladen</span>
        <span class="nur-vorlesen"> – öffnet in neuem Tab</span>
      </a>
    ) : (
      <p>Der Link zum Fotoalbum steht hier, sobald das Album eingerichtet ist.</p>
    )}
  </section>
</Basis>

<style>
  h2 {
    font-size: var(--schrift-h3);
  }

  .knopf {
    display: inline-flex;
    gap: var(--raum-2);
    align-items: center;
    min-height: 44px;
    padding: var(--raum-3) var(--raum-6);
    font-weight: 700;
    color: var(--kachel-blau-text);
    text-decoration: none;
    background: var(--kachel-blau-von);
    border-radius: 999px;
  }
</style>
