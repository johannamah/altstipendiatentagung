---
import { getImage, Image } from "astro:assets";
import { getCollection } from "astro:content";

import Basis from "../layouts/Basis.astro";
import Seitenkopf from "../components/Seitenkopf.astro";
import Ikone from "../components/Ikone.astro";
import Ortsangabe from "../components/Ortsangabe.astro";
import stadtplan from "../assets/orte/stadtplan-hildesheim.png";
import { AUSGANGSORT_ID, WEGE_IM_STADTPLAN } from "../daten/stadtplan.ts";
import { alsKartenpunkte, ARTBEZEICHNUNG, ARTREIHENFOLGE, type Ort } from "../lib/orte.ts";

const orte: Ort[] = (await getCollection("orte")).map((eintrag) => ({
  id: eintrag.id,
  ...eintrag.data,
}));

/* Ein Tippfehler in src/daten/stadtplan.ts soll den Bau anhalten, statt einen
   Ort stillschweigend aus der Textalternative fallen zu lassen. */
const nachKennung = new Map(orte.map((ort) => [ort.id, ort]));
const ortZu = (id: string): Ort => {
  const ort = nachKennung.get(id);
  if (!ort) throw new Error(`Stadtplan: Ort "${id}" fehlt in src/content/orte.json.`);
  return ort;
};

const ausgangsort = ortZu(AUSGANGSORT_ID);
const wege = WEGE_IM_STADTPLAN.map(({ ortId, zusatz, weg }) => {
  const ort = ortZu(ortId);
  return { ziel: zusatz ? `${ort.name} (${zusatz})` : ort.name, adresse: ort.adresse, weg };
});

/* Zum Vergroessern auf dem Smartphone: der ganze Plan in voller Aufloesung,
   aber als WebP statt des rund 2 MB grossen PNG aus dem Repository. */
const vollbild = await getImage({ src: stadtplan, format: "webp", quality: 90 });

/* Die selbst gezeichnete Koordinatenkarte erscheint weiterhin, sobald Orte
   Koordinaten haben. Ob sie neben dem Stadtplan dann noch gebraucht wird, ist
   eine Produktfrage - bis dahin bleibt sie still. */
/* Exkursionsorte stehen vorerst nicht auf dieser Seite (Orga-Team,
   28.11.2026) - sie stehen bei den Exkursionen selbst. In orte.json bleiben
   sie, Programm und Exkursionsseite verweisen darauf. */
const angezeigt = orte.filter((ort) => ort.art !== "exkursion");
const ARTEN_AUF_DIESER_SEITE = ARTREIHENFOLGE.filter((art) => art !== "exkursion");

const punkte = alsKartenpunkte(angezeigt);
const ohneKoordinaten = angezeigt.length - punkte.length;

const gruppen = ARTEN_AUF_DIESER_SEITE.map((art) => ({
  art,
  bezeichnung: ARTBEZEICHNUNG[art],
  orte: angezeigt.filter((ort) => ort.art === art),
})).filter((gruppe) => gruppe.orte.length > 0);
---

<Basis
  titel="Orte & Anfahrt – Jahrestagung 2027"
  beschreibung="Übersicht aller Orte der Altstipendiatentagung 2027 mit Adressen und Wegbeschreibungen."
>
  <Seitenkopf
    ikone="pin"
    titel="Orte & Anfahrt"
    einleitung="Alle Orte der Tagung auf einen Blick. Tippt bei einem Ort auf Google Maps oder Apple Karten, um euch dorthin führen zu lassen."
  />

  {/* Ein Bild aus dem eigenen Build statt eines eingebetteten Kartendienstes:
      Es wird nichts an Dritte übertragen, es braucht keine Einwilligung, und
      der Service Worker hält den Plan nach dem ersten Aufruf auch ohne Netz
      bereit. `priority` lädt ihn sofort und vorrangig: Er ist das Erste, was
      man auf der Seite sieht. */}
  <figure class="stadtplan">
    <Image
      class="plan"
      src={stadtplan}
      alt={`Illustrierter Stadtplan der Hildesheimer Innenstadt. In der Mitte liegt das ${ausgangsort.name}; gepunktete Linien führen von dort mit Gehzeiten zu den Veranstaltungsorten und Hotels. Alle Wege stehen auch als Liste unter dem Plan.`}
      widths={[400, 800, stadtplan.width]}
      sizes="(min-width: 50rem) 46rem, calc(100vw - 3.75rem)"
      quality={85}
      priority
    />
    <figcaption>
      <p>Die Zeiten sind ungefähre Gehzeiten ab dem {ausgangsort.name}.</p>
      {/* Neuer Tab: In der installierten App gäbe es sonst keinen Weg zurück. */}
      <a class="vollbild" href={vollbild.src} target="_blank" rel="noopener">
        Stadtplan in voller Größe öffnen<span class="nur-vorlesen"> – öffnet in neuem Tab</span>
      </a>
    </figcaption>
  </figure>

  {/* Textalternative zum Plan (WCAG 1.1.1) und zugleich lesbar, ohne das Bild
      zu vergrößern. Zugeklappt, damit die Ortsliste nicht weit nach unten
      rutscht. */}
  <details class="karte wege">
    <summary>
      <span>Wege ab dem {ausgangsort.name}</span>
      <Ikone name="arrow-right" class="pfeil" />
    </summary>
    <ul aria-label={`Wege ab dem ${ausgangsort.name}`}>
      {wege.map(({ ziel, adresse, weg }) => (
        <li>
          <strong>{ziel}</strong>
          {adresse && `, ${adresse}`}: {weg}
        </li>
      ))}
    </ul>
  </details>

  {punkte.length > 0 && (
    /* Selbst gezeichnet statt ein Kartendienst eingebettet: So wird nichts
         an Dritte übertragen, es braucht keine Einwilligung, und die Karte
         funktioniert auch ohne Netz. Sie zeigt die Lage zueinander, keine
         Straßen – wer hin will, nutzt die Weiterleitung. */
    <figure class="karte-flaeche">
      <svg viewBox="0 0 100 100" role="img" aria-labelledby="kartentitel">
        <title id="kartentitel">
            Übersichtskarte mit {punkte.length} Orten der Tagung. Die genauen Adressen stehen in
            der Liste darunter.
          </title>

        {punkte.map((punkt) => (
          <g class="markierung" data-art={punkt.ort.art}>
            <circle cx={punkt.x} cy={punkt.y} r="1.8" />
            <text x={punkt.x} y={punkt.y - 3}>
              {punkt.ort.name}
            </text>
          </g>
        ))}
      </svg>

      <figcaption>
        Schematische Übersicht – sie zeigt die Lage zueinander, nicht den Straßenverlauf.
        {ohneKoordinaten > 0 && (
          <>
            {" "}
            {ohneKoordinaten} von {angezeigt.length} Orten fehlen noch die Koordinaten und sind
            deshalb nicht eingezeichnet.
          </>
        )}
      </figcaption>
    </figure>
  )}

  {gruppen.map((gruppe) => (
    <section class="gruppe">
      <h2>{gruppe.bezeichnung}</h2>
      <ul>
        {gruppe.orte.map((ort) => (
          <li class="karte">
            {ort.hinweis && <p class="hinweis">{ort.hinweis}</p>}
            <Ortsangabe ort={ort} />
          </li>
        ))}
      </ul>
    </section>
  ))}
</Basis>

<style>
  /* Schmaler als die Seite: In voller Breite wäre der hochformatige Plan auf
     dem Desktop rund 1500 px hoch. Feinheiten zeigt die volle Größe. */
  .stadtplan,
  .wege {
    max-width: 48rem;
  }

  .stadtplan {
    padding: var(--raum-3);
    margin: 0 0 var(--raum-4);
    background: var(--karte);
    border: 1px solid var(--rand);
    border-radius: var(--radius);
    box-shadow: var(--schatten);
  }

  .plan {
    display: block;
    width: 100%;
    height: auto;
    border-radius: calc(var(--radius) - var(--raum-3));
  }

  .stadtplan figcaption p {
    margin: 0;
  }

  .vollbild {
    /* Mindestgröße für Berührung (Regel 7). */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
  }

  .wege {
    padding: 0;
    margin: 0 0 var(--raum-8);
  }

  .wege summary {
    /* Mindestgröße für Berührung (Regel 7). */
    display: flex;
    gap: var(--raum-3);
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    padding: var(--raum-3) var(--raum-4);
    font-weight: 600;
    cursor: pointer;
  }

  /* Wie bei den Programmpunkten: eigener Pfeil statt Dreieck, er dreht sich
     beim Aufklappen. */
  .wege summary::marker {
    content: "";
  }

  .wege summary::-webkit-details-marker {
    display: none;
  }

  .wege summary:hover {
    background: var(--hover);
  }

  .wege[open] summary {
    border-bottom: 1px solid var(--rand);
  }

  .pfeil {
    flex: none;
    color: var(--text-leise);
    transform: rotate(90deg);
    transition: transform var(--dauer-kurz) ease;
  }

  .wege[open] .pfeil {
    transform: rotate(-90deg);
  }

  .wege ul {
    padding: var(--raum-3) var(--raum-4) var(--raum-4) var(--raum-8);
    margin: 0;
  }

  .wege li + li {
    margin-top: var(--raum-2);
  }

  .karte-flaeche {
    padding: var(--raum-4);
    margin: 0 0 var(--raum-8);
    background: var(--karte);
    border: 1px solid var(--rand);
    border-radius: var(--radius);
    box-shadow: var(--schatten);
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    /* Etwas höher als breit wirkt auf dem Smartphone ruhiger. */
    aspect-ratio: 4 / 3;
  }

  .markierung circle {
    fill: var(--akzent);
  }

  .markierung text {
    font-size: 3px;
    text-anchor: middle;
    fill: var(--text);
  }

  /* Die Art wird zusätzlich über die Gruppen in der Liste vermittelt –
     Farbe ist hier Zugabe, nicht Informationsträger (Regel 19). */
  .markierung[data-art="tagungsort"] circle {
    r: 2.6;
    fill: var(--kachel-pink-von);
  }

  .markierung[data-art="uebernachtung"] circle {
    fill: var(--kachel-lila-von);
  }

  figcaption {
    margin-top: var(--raum-3);
    font-size: var(--schrift-klein);
    color: var(--text-leise);
  }

  .gruppe {
    margin-bottom: var(--raum-8);
  }

  h2 {
    font-size: var(--schrift-h3);
  }

  .gruppe ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: var(--raum-4);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .gruppe .karte {
    margin-bottom: 0;
  }

  .hinweis {
    margin: 0 0 var(--raum-2);
    font-size: var(--schrift-klein);
    font-weight: 600;
    color: var(--akzent);
  }
</style>
