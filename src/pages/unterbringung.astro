---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

import Basis from "../layouts/Basis.astro";
import Seitenkopf from "../components/Seitenkopf.astro";
import Ikone from "../components/Ikone.astro";
import Ortsangabe from "../components/Ortsangabe.astro";
import { telefonVerweis } from "../lib/text.ts";

const orte = new Map(
  (await getCollection("orte")).map((eintrag) => [eintrag.id, { id: eintrag.id, ...eintrag.data }]),
);
const alle = (await getCollection("unterkuenfte")).sort(
  (a, b) => a.data.reihenfolge - b.data.reihenfolge,
);
const mitKontingent = alle.filter((eintrag) => eintrag.data.kontingent);
const empfehlungen = alle.filter((eintrag) => !eintrag.data.kontingent);
---

<Basis
  titel="Unterbringung – Jahrestagung 2027"
  beschreibung="Hotelkontingente und Übernachtungsempfehlungen für die Altstipendiatentagung 2027 in Hildesheim."
>
  <Seitenkopf
    ikone="bed"
    titel="Unterbringung"
    einleitung="Für die Jahrestagung sind in mehreren Hotels Abrufkontingente reserviert. Bitte bucht frühzeitig direkt beim Hotel – die Kontingente sind begrenzt und werden von den Hotels selbst nach dem Prinzip „first come, first served“ vergeben."
  />

  <h2>Hotels mit Zimmerkontingent</h2>

  {mitKontingent.map(({ data: haus }) => (
    <section class:list={["karte", "haus", { "mit-bild": haus.bild }]}>
      {haus.bild && (
        /* Verkleinert und als WebP ausgeliefert; lazy, weil nur das erste Hotel
             im ersten Bildschirm steht. */
        <Image
          class="hausbild"
          src={haus.bild}
          alt={haus.bildbeschreibung ?? ""}
          widths={[400, 800]}
          sizes="(min-width: 48rem) 22rem, calc(100vw - 4rem)"
        />
      )}
      <div class="angaben">
        <h3>{haus.name}</h3>

        {haus.stichwort && (
          <p class="stichwort">
            Bei der Buchung angeben: <b>„{haus.stichwort}“</b>
            {haus.zeitraum && <> · Zeitraum {haus.zeitraum}</>}
          </p>
        )}

        {haus.zimmer.length > 0 && (
          /* Die Tabelle darf breiter sein als ein schmales Display und scrollt dann
             in ihrem eigenen Bereich - die Seite nie (Regel 10). tabindex macht den
             Bereich mit der Tastatur scrollbar. */
          <div
            class="tabellenbereich"
            tabindex="0"
            role="group"
            aria-label={`Zimmerkontingent ${haus.name}`}
          >
            <table>
              <thead>
                <tr>
                  <th scope="col">Zimmerart</th>
                  <th scope="col">Reserviert</th>
                  <th scope="col">Preis</th>
                </tr>
              </thead>
              <tbody>
                {haus.zimmer.map((zimmer) => (
                  <tr>
                    <th scope="row">
                      {zimmer.typ}
                      {zimmer.hinweis && <span class="zimmerhinweis">{zimmer.hinweis}</span>}
                    </th>
                    <td>{zimmer.anzahl ?? "keine Angabe"}</td>
                    <td>{zimmer.preis}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        {haus.fruehstueck && (
          <p class="zeile">
            <Ikone name="coffee" />
            <span>Frühstück: {haus.fruehstueck}</span>
          </p>
        )}
        {haus.hinweis && (
          <p class="kontingenthinweis">
            <Ikone name="alert" />
            <span>{haus.hinweis}</span>
          </p>
        )}
        {haus.web && (
          <p>
            <a class="buchen" href={haus.web} target="_blank" rel="noopener">
              <Ikone name="globe" />
              Buchen<span class="nur-vorlesen">: {haus.name}</span>
            </a>
          </p>
        )}
        {haus.ortId && orte.get(haus.ortId) && <Ortsangabe ort={orte.get(haus.ortId)!} />}
        {haus.telefon && (
          <p class="zeile">
            <Ikone name="phone" />
            <a href={telefonVerweis(haus.telefon)}>{haus.telefon}</a>
          </p>
        )}
        {haus.email && (
          <p class="zeile">
            <Ikone name="mail" />
            <a href={`mailto:${haus.email}`}>{haus.email}</a>
          </p>
        )}
      </div>
    </section>
  ))}

  {/* Seit dem Programmheft 2027 haben alle Hotels ein Kontingent. Kommen
      Empfehlungen ohne Kontingent dazu, erscheint der Abschnitt wieder. */}
  {empfehlungen.length > 0 && (
    <>
      <h2>Weitere Übernachtungsempfehlungen</h2>
      <p class="einleitung">
        Diese Hotels haben kein eigenes Zimmerkontingent für die Tagung – die Buchung erfolgt
        individuell direkt beim Hotel.
      </p>

      <ul class="empfehlungen">
        {empfehlungen.map(({ data: haus }) => (
          <li class="karte">
            <h3>{haus.name}</h3>
            {haus.ortId && orte.get(haus.ortId) && <Ortsangabe ort={orte.get(haus.ortId)!} />}
            {haus.telefon && (
              <p class="zeile">
                <Ikone name="phone" />
                <a href={telefonVerweis(haus.telefon)}>{haus.telefon}</a>
              </p>
            )}
            {haus.email && (
              <p class="zeile">
                <Ikone name="mail" />
                <a href={`mailto:${haus.email}`}>{haus.email}</a>
              </p>
            )}
            {haus.web && (
              <p class="zeile">
                <Ikone name="globe" />
                <a href={haus.web} target="_blank" rel="noopener">
                  Website des Hotels
                </a>
              </p>
            )}
          </li>
        ))}
      </ul>
    </>
  )}
</Basis>

<style>
  /* Auf breiten Bildschirmen steht das Bild links neben den Angaben, auf dem
     Smartphone darüber. */
  .haus {
    display: grid;
    gap: var(--raum-4);
  }

  @media (min-width: 48rem) {
    .haus.mit-bild {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      align-items: start;
    }
  }

  .hausbild {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius-klein);
  }

  .angaben > :first-child {
    margin-top: 0;
  }

  h2 {
    margin-top: var(--raum-8);
  }

  .einleitung {
    color: var(--text-leise);
  }

  h3 {
    font-size: var(--schrift-h3);
  }

  .zimmerhinweis {
    display: block;
    font-size: var(--schrift-klein);
    font-weight: 400;
    color: var(--text-leise);
  }

  .kontingenthinweis {
    display: flex;
    gap: var(--raum-2);
    align-items: flex-start;
    padding: var(--raum-2) var(--raum-3);
    color: var(--hinweis-text);
    background: var(--hinweis-flaeche);
    border: 1px solid var(--hinweis-rand);
    border-radius: var(--radius-klein);
  }

  .buchen {
    display: inline-flex;
    gap: var(--raum-2);
    align-items: center;
    min-height: 44px;
    padding: var(--raum-2) var(--raum-6);
    font-weight: 700;
    color: var(--kachel-blau-text);
    text-decoration: none;
    background: var(--kachel-blau-von);
    border-radius: 999px;
  }

  .stichwort {
    padding: var(--raum-2) var(--raum-3);
    color: var(--schlagwort-text);
    background: var(--schlagwort-flaeche);
    border: 1px solid var(--schlagwort-rand);
    border-radius: var(--radius-klein);
  }

  /* position: relative ist Voraussetzung dafuer, dass der Bereich wirklich alles
     beschneidet: Ein Scrollcontainer beschneidet absolut positionierte Nachfahren
     nur, wenn er selbst ihr umschliessender Block ist. Genau daran ist die
     Zeitachse zuvor gescheitert. */
  .tabellenbereich {
    position: relative;
    margin-bottom: var(--raum-4);
    overflow-x: auto;
  }

  .tabellenbereich:focus-visible {
    outline: 3px solid var(--fokus);
    outline-offset: 2px;
  }

  table {
    width: 100%;
    /* Nicht unter die Mindestbreite quetschen - dann lieber scrollen. */
    min-width: 18rem;
    border-collapse: collapse;
  }

  th,
  td {
    padding: var(--raum-2);
    text-align: left;
    border-bottom: 1px solid var(--rand);
  }

  thead th {
    font-size: var(--schrift-klein);
    color: var(--text-leise);
  }

  .zeile {
    display: flex;
    gap: var(--raum-2);
    align-items: center;
    margin-bottom: var(--raum-1);
    font-size: var(--schrift-klein);
    color: var(--text-leise);
  }

  /* Touch-Ziele mindestens 44 px hoch (Designregel 7, WCAG 2.5.8): Telefon und
     E-Mail stehen dicht neben "Adresse kopieren". */
  .zeile a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .empfehlungen {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: var(--raum-4);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .empfehlungen .karte {
    margin-bottom: 0;
  }
</style>
