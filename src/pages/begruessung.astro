---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

import Basis from "../layouts/Basis.astro";
import Seitenkopf from "../components/Seitenkopf.astro";
import Platzhalterhinweis from "../components/Platzhalterhinweis.astro";

const eintraege = await getCollection("grussworte");
const grussworte = eintraege
  .map((eintrag) => eintrag.data)
  .sort((a, b) => a.reihenfolge - b.reihenfolge);

const alleVorlaeufig = grussworte.every((grusswort) => grusswort.status !== "bestaetigt");
---

<Basis
  titel="Begrüßungsworte – Jahrestagung 2027"
  beschreibung="Grußworte zur Altstipendiatentagung 2027 in Hildesheim."
>
  <Seitenkopf
    ikone="message"
    titel="Begrüßungsworte"
    einleitung="Ein herzliches Willkommen zur Jahrestagung 2027."
  />

  {alleVorlaeufig && (
    <Platzhalterhinweis>
      Die folgenden Texte sind Beispiele und noch nicht abgestimmt. Die Originaltexte werden
      nachgereicht; bis dahin bitte nichts davon zitieren oder weitergeben. Auch die Bildnachweise
      fehlen noch.
    </Platzhalterhinweis>
  )}

  {grussworte.map((grusswort) => (
    <article class="grusswort">
      <header>
        {grusswort.bild && (
          /* Astro erzeugt beim Bauen passende Groessen und liefert WebP aus.
               Das Ausgangsbild eines Portraits hat 1 MB - das waere auf einem
               Mobilfunknetz spuerbar (Annahme A5). */
          <Image
            class="portrait"
            src={grusswort.bild}
            alt={`Porträt von ${grusswort.name}`}
            width={160}
            height={200}
            densities={[1, 2]}
          />
        )}

        <div>
          <h2>{grusswort.name}</h2>
          <p class="rolle">{grusswort.rolle}</p>
          {grusswort.status !== "bestaetigt" && (
            <p class="marke">Beispieltext – Originaltext folgt</p>
          )}
        </div>
      </header>

      <div class="text">
        {grusswort.absaetze.map((absatz) => (
          <p>{absatz}</p>
        ))}
      </div>

      {grusswort.bildnachweis && !grusswort.bildnachweis.startsWith("[") && (
        <p class="nachweis">Bild: {grusswort.bildnachweis}</p>
      )}
    </article>
  ))}
</Basis>

<style>
  .grusswort {
    padding: var(--raum-4);
    margin-bottom: var(--raum-6);
    background: var(--karte);
    border: 1px solid var(--rand);
    border-radius: var(--radius);
    box-shadow: var(--schatten);
  }

  header {
    display: flex;
    flex-wrap: wrap;
    gap: var(--raum-4);
    align-items: flex-start;
    margin-bottom: var(--raum-4);
  }

  .portrait {
    width: 100px;
    height: auto;
    object-fit: cover;
    border-radius: var(--radius-klein);
  }

  h2 {
    margin-bottom: var(--raum-1);
    font-size: var(--schrift-h3);
  }

  .rolle {
    margin-bottom: var(--raum-2);
    font-size: var(--schrift-klein);
    color: var(--text-leise);
  }

  /* Der Hinweis steht als Text, nicht nur als Farbe (Regel 19) - und direkt am
     Namen, damit niemand den Beispieltext fuer abgestimmt haelt. */
  .marke {
    display: inline-block;
    padding: 2px var(--raum-2);
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--hinweis-text);
    background: var(--hinweis-flaeche);
    border: 1px solid var(--hinweis-rand);
    border-radius: 999px;
  }

  .text p:last-child {
    margin-bottom: 0;
  }

  .nachweis {
    margin: var(--raum-4) 0 0;
    font-size: 0.75rem;
    color: var(--text-leise);
  }
</style>
