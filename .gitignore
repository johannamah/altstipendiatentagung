# Abhaengigkeiten (im Dev-Container ein eigenes Docker-Volume unter /workspace/node_modules)
node_modules/

# Betriebssystem-Artefakte
.DS_Store
Thumbs.db
desktop.ini

# Editor-/Werkzeugverzeichnisse
.vscode/
.idea/
*.swp

# Build-Ergebnisse und Zwischenstaende
dist/
.astro/

# Testberichte
playwright-report/
test-results/
lighthouse-bericht/
.lighthouseci/

# Lokale Umgebungsvariablen - gehoeren nie ins Repository (AGENTS.md)
.env
.env.*
!.env.example

# Word-Sperrdateien (entstehen, solange ein Dokument geoeffnet ist)
~$*

# Quelldokumente des Orga-Teams. Sie koennen Kontaktdaten von Ansprechpersonen
# enthalten und gehoeren nicht in das oeffentliche Repository; uebernommen
# werden nur die freigegebenen Texte nach src/content/.
src/**/*.docx

# Lokale Vercel-Verknuepfung (npx vercel link) und gezogene Umgebungsvariablen
.vercel/

# Ablage des Orga-Teams: Rohdateien (Originalfotos, Programmheft) direkt in
# src/assets/. Sie koennen Metadaten wie GPS-Koordinaten enthalten und sind
# viel zu gross. In die App kommen nur aufbereitete Fassungen in Unterordnern
# (src/assets/kontakte/, src/assets/grussworte/).
/src/assets/*.*
