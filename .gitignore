# Abhaengigkeiten (im Dev-Container ein eigenes Docker-Volume unter /workspace/node_modules)
node_modules/

# Betriebssystem-Artefakte
.DS_Store
Thumbs.db
desktop.ini

# Editor-/Werkzeugverzeichnisse
.vscode/
.idea/
*.swp

# Build-Ergebnisse und Zwischenstaende
dist/
.astro/

# Testberichte
playwright-report/
test-results/
lighthouse-bericht/
